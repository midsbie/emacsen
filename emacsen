#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit

fatal() {
    printf 'emacsen: %s\n' "$*" >&2
    exit 1
}

require_commands() {
    local command

    for command; do
        command -v "$command" >/dev/null || fatal "required command not found: $command"
    done
}

usage() {
    cat <<'EOF'
Usage: emacsen build NAME [--variant x|server]
       emacsen run NAME [--directory DIR] [-- EMACS-ARGS...]
       emacsen exec NAME [--directory DIR] -- COMMAND [ARGS...]
       emacsen install NAME [--into DIR]
       emacsen uninstall VERSION [--from DIR]
       emacsen update NAME
       emacsen --help

Build a retained Docker image from a source recipe.  Run that local image's
Emacs, or COMMAND for exec, with DIR (default: current directory) read-only at
/work.  When attached to a terminal, provide a terminal inside the container.
Run and exec never build or pull an image. Arguments are passed unchanged.
Update locks a Git recipe's ref to a commit; builds use that lock unchanged.
Install and uninstall use a rootful Docker daemon and default to /usr/local,
where versions coexist and the last install owns bin/emacs. Uninstall requires
exactly one recorded version and the image that installed it.
EOF
}

declare -A recipe=()
# The only image prefix install accepts. Install and uninstall mount their target there and default
# to it, since an installed Emacs runs only from its prefix.
readonly install_prefix=/usr/local
# emacsen's state in a prefix, relative to it: installation records and the prefix lock.
readonly state_directory=lib/emacsen
readonly version_pattern='[0-9]+(\.[0-9]+)+'
# Metadata and build-info keys. They become associative-array subscripts, so they admit no character
# Bash expands.
readonly key_pattern='[a-z][a-z0-9-]*'

read_metadata() {
    local file=$1 kind=$2 line key
    local -n fields=$3

    fields=()

    while IFS= read -r line || [[ -n $line ]]; do
        [[ -z $line || $line == \#* ]] && continue
        [[ $line =~ ^($key_pattern)=(.*)$ ]] || fatal "invalid $kind line in $file: $line"

        key=${BASH_REMATCH[1]}
        # Quoted, so that Bash 5.0 and 5.1 expand the subscript once, as later versions do.
        [[ ! -v 'fields[$key]' ]] || fatal "duplicate $kind key in $file: $key"
        fields["$key"]=${BASH_REMATCH[2]}
    done < "$file"
}

# Refuse keys of the associative array METADATA, read from FILE, other than KEYS.
check_keys() {
    local file=$1 kind=$2 key
    local -n metadata=$3
    local -A allowed=()
    shift 3

    for key; do allowed[$key]=1; done
    for key in "${!metadata[@]}"; do
        [[ -v 'allowed[$key]' ]] || fatal "unknown $kind key in $file: $key"
    done
}

read_recipe() {
    local file=$1/recipe

    read_metadata "$file" recipe recipe
    case ${recipe[source]-} in
        tarball) check_keys "$file" 'tarball recipe' recipe source url sha256 version builder ;;
        git) check_keys "$file" 'git recipe' recipe source url ref version builder ;;
        '') fatal "recipe has no source: $file" ;;
        *) fatal "unknown source in $file: ${recipe[source]}" ;;
    esac

    [[ ${recipe[builder]-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
        || fatal "recipe requires a valid builder name: $file"
    [[ -n ${recipe[url]-} ]] || fatal "recipe requires a source url: $file"
}

# Set source_sha256 and source_info in the caller and put the recipe's source in SCRATCH/source.
materialize_source() {
    local scratch=$1

    mkdir -p -- "$scratch/source"

    case ${recipe[source]} in
        tarball) materialize_tarball "$scratch" ;;
        git) materialize_git "$scratch" ;;
        *) fatal "not implemented: ${recipe[source]}" ;;
    esac
}

# Set source_info in the caller from common fields and extra KEY VALUE pairs.
set_source_info() {
    (( $# % 2 == 0 )) || fatal "source info requires key/value pairs"

    printf -v source_info '%s: %s\n' \
           source-kind "${recipe[source]}" \
           source-sha256 "$source_sha256" \
           "$@"
    source_info=${source_info%$'\n'}
}

materialize_tarball() {
    local scratch=$1 cache download_url

    [[ ${recipe[sha256]-} =~ ^[0-9a-f]{64}$ ]] \
        || fatal "tarball recipe requires a lowercase 64-digit sha256"

    source_sha256=${recipe[sha256]}
    cache="$root/.emacsen/sources/tarballs/$source_sha256"

    if [[ -f $cache ]]; then
        printf 'emacsen: using cached source %s\n' "$source_sha256" >&2
        printf '%s  %s\n' "$source_sha256" "$cache" | sha256sum --check --strict >&2
        download_url=$(<"$cache.url")
    else
        printf 'emacsen: downloading %s\n' "${recipe[url]}" >&2
        download_url=$(curl --fail --location --show-error --retry 3 --connect-timeout 30 \
            --output "$scratch/download" --write-out '%{url_effective}' -- "${recipe[url]}")
        printf '%s  %s\n' "$source_sha256" "$scratch/download" | sha256sum --check --strict >&2
        mkdir -p -- "${cache%/*}"
        # The URL goes first so that a cached archive always has one.
        printf '%s\n' "$download_url" > "$scratch/download-url"
        mv -- "$scratch/download-url" "$cache.url"
        mv -- "$scratch/download" "$cache"
    fi

    cp -- "$cache" "$scratch/source/archive"
    set_source_info \
        source-url "${recipe[url]}" \
        download-url "$download_url"
}

materialize_git() {
    local scratch=$1 mirror="$root/.emacsen/sources/emacs.git" bare type lock

    mkdir -p -- "${mirror%/*}" \
        || fatal "cannot create source Git cache directory: ${mirror%/*}"
    exec {lock}>> "$mirror.lock" \
        || fatal "cannot open source Git cache lock: $mirror.lock"
    if ! flock --nonblock "$lock"; then
        printf 'emacsen: waiting for source Git cache %s\n' "$mirror" >&2
        flock "$lock" || fatal "cannot lock source Git cache: $mirror.lock"
    fi

    if [[ ! -e $mirror && ! -L $mirror ]]; then
        git init --bare "$mirror" >&2 \
            || fatal "cannot initialise source Git cache: $mirror"
    fi

    [[ -d $mirror ]] \
        || fatal "source Git cache is not a directory: $mirror"
    bare=$(git --git-dir="$mirror" rev-parse --is-bare-repository 2>/dev/null) \
        || fatal "source Git cache is not a valid repository: $mirror"
    [[ $bare == true ]] \
        || fatal "source Git cache is not a bare repository: $mirror"

    if ! git --git-dir="$mirror" cat-file -e "$source_commit" 2>/dev/null; then
        # Detached auto-maintenance would inherit the lock and hold it past release. Older Git reads
        # only gc.autoDetach, and maintenance.autoDetach overrides it where both exist.
        git -c maintenance.autoDetach=false -c gc.autoDetach=false --git-dir="$mirror" \
            fetch --depth 1 --no-tags -- "${recipe[url]}" "$source_commit" >&2 \
            || fatal "cannot fetch locked source commit $source_commit from ${recipe[url]}"
    fi

    type=$(git --git-dir="$mirror" cat-file -t "$source_commit") \
        || fatal "cannot read locked source object $source_commit from cache: $mirror"
    [[ $type == commit ]] \
        || fatal "locked source is a $type, not a commit: $source_commit; run: emacsen update $name"

    # Keep cached commits reachable without following a moving upstream ref.
    git --git-dir="$mirror" update-ref "refs/emacsen/$source_commit" "$source_commit" \
        || fatal "cannot retain locked source commit $source_commit in cache: $mirror"
    exec {lock}>&-

    git --git-dir="$mirror" archive --format=tar --prefix=emacs/ "$source_commit" \
        > "$scratch/source/archive" \
        || fatal "cannot archive locked source commit $source_commit from cache: $mirror"

    source_sha256=$(sha256sum -- "$scratch/source/archive")
    source_sha256=${source_sha256%% *}
    set_source_info \
        source-url "${recipe[url]}" \
        source-ref "${recipe[ref]}" \
        source-commit "$source_commit"
}

# Print the object REF names in the repository at URL, peeled past annotated tags.
resolve_remote_ref() {
    local url=$1 ref=$2 remote oid listed extra object='' peeled=''

    # ls-remote lists an annotated tag's own object, and as REF^{} the object it peels to.
    remote=$(git ls-remote --exit-code -- "$url" "$ref" "$ref^{}") \
        || fatal "cannot resolve git ref: $ref"
    while read -r oid listed extra; do
        [[ $oid =~ ^[0-9a-f]{40}$ && -z $extra ]] \
            || fatal "git ref must resolve to exactly one commit: $ref"
        if [[ $listed == "$ref" && -z $object ]]; then
            object=$oid
        elif [[ $listed == "$ref^{}" && -z $peeled ]]; then
            peeled=$oid
        else
            fatal "git ref must resolve to exactly one commit: $ref"
        fi
    done <<< "$remote"
    [[ -n $object ]] || fatal "git ref must resolve to exactly one commit: $ref"

    printf '%s\n' "${peeled:-$object}"
}

update_source() (
    local name=$1 directory="$root/recipes/$1"
    local remote_commit line old_commit=none contents scratch

    require_commands git mktemp
    read_recipe "$directory"
    [[ ${recipe[source]-} == git ]] \
        || fatal "nothing to lock for recipe: $name"
    [[ -n ${recipe[ref]-} ]] \
        || fatal "git recipe requires ref: $directory/recipe"
    git check-ref-format "${recipe[ref]}" >/dev/null \
        || fatal "git recipe requires a full ref name: ${recipe[ref]}"

    remote_commit=$(resolve_remote_ref "${recipe[url]}" "${recipe[ref]}")
    printf -v contents 'ref=%s\ncommit=%s' "${recipe[ref]}" "$remote_commit"
    if [[ -f $directory/lock ]]; then
        if [[ $(<"$directory/lock") == "$contents" ]]; then
            printf 'emacsen: %s unchanged (%s)\n' "$name" "$remote_commit" >&2
            return
        fi

        while IFS= read -r line || [[ -n $line ]]; do
            if [[ $line == commit=* ]]; then old_commit=${line#commit=}; fi
        done < "$directory/lock"
    fi

    scratch=$(mktemp "$directory/.lock-XXXXXXXX")
    trap 'rm -f -- "$scratch"' EXIT
    printf '%s\n' "$contents" > "$scratch"
    mv -- "$scratch" "$directory/lock"
    printf 'emacsen: %s %s -> %s\n' "$name" "$old_commit" "$remote_commit" >&2
)

read_git_lock() {
    local directory=$1 file=$1/lock
    local hint="run: emacsen update ${directory##*/}"
    local -A lock=()

    [[ -n ${recipe[ref]-} ]] \
        || fatal "git recipe requires ref: $directory/recipe"
    git check-ref-format "${recipe[ref]}" >/dev/null \
        || fatal "git recipe requires a full ref name: ${recipe[ref]}"
    [[ -f $file ]] \
        || fatal "git recipe requires a lock; $hint"

    read_metadata "$file" 'git lock' lock
    check_keys "$file" 'git lock' lock ref commit

    [[ ${lock[ref]-} == "${recipe[ref]}" && ${lock[commit]-} =~ ^[0-9a-f]{40}$ ]] \
        || fatal "git lock does not match recipe or has an invalid commit; $hint"
    source_commit=${lock[commit]}
}

image_file() (
    local image=$1 path=$2 destination=$3 container='' cleanup_status=0

    trap '
        cleanup_status=$?
        if [[ -n $container ]]; then
            docker container rm "$container" >/dev/null || true
        fi
        exit "$cleanup_status"
    ' EXIT

    container=$(docker create --pull=never --network=none --read-only \
                       --entrypoint /bin/true "$image") \
        || fatal "cannot create container for image: $image"
    docker cp "$container:$path" "$destination" \
        || fatal "cannot read $path from image: $image"
)

build_image() (
    local name=$1
    shift

    local directory="$root/recipes/$name"
    local tag="emacsen:$name"
    local revision source_status dirty=false source_sha256 source_info source_commit
    local inputs scratch image_id record builder builder_directory variants
    local variant='' variant_seen=false
    local variant_options=() builder_paths=() declared_variants=()
    local -A builder_metadata=()
    local cleanup_status=0

    while (( $# )); do
        case $1 in
            --variant)
                [[ $variant_seen == false ]] || fatal "--variant may be specified only once"
                [[ $# -ge 2 && -n $2 && $2 != --* ]] || fatal "--variant requires x or server"
                variant=$2
                variant_seen=true
                shift 2
                ;;
            *) fatal "expected --variant x|server, got: $1" ;;
        esac
    done

    read_recipe "$directory"

    builder=${recipe[builder]}
    builder_directory="$root/builders/$builder"
    builder_paths=("recipes/$name" "builders/$builder")
    [[ -f $builder_directory/builder && -f $builder_directory/Dockerfile
       && -f $builder_directory/build.sh ]] \
        || fatal "builder requires builder, Dockerfile and build.sh: $builder_directory"

    read_metadata "$builder_directory/builder" builder builder_metadata
    check_keys "$builder_directory/builder" builder builder_metadata variants

    variants=${builder_metadata[variants]-}
    if [[ -n $variants ]]; then
        read -r -a declared_variants <<< "$variants"
        if [[ $variant_seen == false ]]; then
            if dpkg -s libx11-6 >/dev/null 2>&1; then variant=x; else variant=server; fi
        fi

        local supported=false declared
        for declared in "${declared_variants[@]}"; do
            if [[ $variant == "$declared" ]]; then supported=true; fi
        done
        [[ $supported == true ]] \
            || fatal "unsupported variant for $builder: $variant (expected $variants)"
        variant_options=(--build-arg "VARIANT=$variant")
    elif [[ $variant_seen == true ]]; then
        fatal "builder $builder declares no variants"
    fi

    if [[ ${recipe[source]} == git ]]; then read_git_lock "$directory"; fi

    require_commands docker git sha256sum find sort xargs mktemp curl flock

    revision=$(git -C "$root" rev-parse --verify HEAD) \
        || fatal "build requires a Git checkout of emacs-builder"
    source_status=$(
        git -C "$root" status --porcelain --untracked-files=all -- \
            emacsen "${builder_paths[@]}"
    )
    if [[ -n $source_status ]]; then dirty=true; fi
    inputs=$(
        cd -- "$root"
        sha256sum -- emacsen
        find "${builder_paths[@]}" -type f -print0 | sort -z | xargs -0 sha256sum --
    )

    docker info >/dev/null \
        || fatal "cannot access Docker; check the daemon and your Docker permissions"

    mkdir -p -- "$root/.emacsen/builds"
    scratch=$(mktemp -d "$root/.emacsen/builds/.build-XXXXXXXX")
    trap '
        cleanup_status=$?
        rm -rf -- "$scratch"
        exit "$cleanup_status"
    ' EXIT

    materialize_source "$scratch"

    printf 'emacsen: building %s\n' "$tag" >&2
    docker build --pull --load \
        --tag "$tag" \
        --iidfile "$scratch/image-id" \
        --build-context "source=$scratch/source" \
        --build-arg "SOURCE_SHA256=$source_sha256" \
        --build-arg "EMACS_VERSION=${recipe[version]-}" \
        "${variant_options[@]}" \
        --build-arg "BUILDER_REVISION=$revision" \
        --build-arg "BUILDER_DIRTY=$dirty" \
        --build-arg "BUILDER_INPUTS=$inputs" \
        --build-arg "SOURCE_INFO=$source_info" \
        "$builder_directory" >&2

    image_id=$(<"$scratch/image-id")
    image_file "$image_id" /usr/share/emacsen/build-info "$scratch/build-info"
    record="$root/.emacsen/builds/${image_id#sha256:}.txt"
    {
        printf 'image-id: %s\nimage-tag: %s\n\n' "$image_id" "$tag"
        cat "$scratch/build-info"
    } > "$scratch/record"
    mv -- "$scratch/record" "$record"
    printf 'emacsen: built %s (%s)\nemacsen: build record %s\n' "$tag" "$image_id" "$record" >&2
)

check_rootful() {
    [[ $1 != *name=rootless* ]] || fatal "install and uninstall require a rootful Docker daemon"
}

# Read the key: value header that build-info and installation records share from FILE into the
# associative array HEADER; the sections after it are not read.
read_info_header() {
    local file=$1 line key
    local -n header=$2

    header=()

    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line == \[* ]] && break
        [[ -z $line ]] && continue

        [[ $line =~ ^($key_pattern)': '(.*)$ ]] \
            || fatal "invalid header line in $file: $line"

        key=${BASH_REMATCH[1]}
        [[ ! -v 'header[$key]' ]] || fatal "duplicate header field in $file: $key"
        header["$key"]=${BASH_REMATCH[2]}
    done < "$file"
}

# Validate the build-info of recipe NAME's image and set build_tree, emacs_version and
# source_directory in the caller.
check_installable() {
    local file=$1 name=$2 key host_os sources
    local -A info=()

    read_info_header "$file" info

    [[ -n ${info[build-tree]-} ]] \
        || fatal "image is not host-installable"
    [[ ${info[prefix]-} == "$install_prefix" ]] \
        || fatal "install requires image prefix $install_prefix"
    [[ ${info[emacs-version]-} =~ ^$version_pattern$ ]] \
        || fatal "invalid build-info emacs-version: ${info[emacs-version]-missing}"

    # The C sources install beside the version's lisp and etc, where its dumped Emacs looks.
    key=source-directory
    sources=$install_prefix/share/emacs/${info[emacs-version]}/
    [[ ${info[$key]-} == "$sources" ]] \
        || fatal "image $key (${info[$key]-missing}) is not $sources;" \
                 "rebuild it with: $root/emacsen build $name"

    host_os=$(
        # shellcheck disable=SC1091 # Supplied by the host distribution.
        . /etc/os-release
        printf '%s %s' "$ID" "$VERSION_ID"
    )
    [[ ${info[os-release]-} == "$host_os" ]] \
        || fatal "image os-release (${info[os-release]-missing}) does not match host ($host_os)"

    build_tree=${info[build-tree]}
    emacs_version=${info[emacs-version]}
    source_directory=$sources
}

# Validate the installation record FILE of Emacs VERSION and set tag, image_id, build_tree and
# emacs_version in the caller.
check_uninstallable() {
    local file=$1 version=$2 key
    local -A installed=()

    [[ -f $file ]] || fatal "no installation record for Emacs $version: $file"
    read_info_header "$file" installed

    key='image-id'
    image_id=${installed[$key]-}
    [[ $image_id =~ ^sha256:[0-9a-f]{64}$ ]] \
        || fatal "invalid $key in $file: ${image_id:-missing}"

    key='image-tag'
    tag=${installed[$key]-}
    [[ -n $tag ]] \
        || fatal "missing $key in $file"

    build_tree=${installed[build-tree]-}
    [[ -n $build_tree ]] \
        || fatal "missing build-tree in $file"

    [[ ${installed[emacs-version]-} == "$version" ]] \
        || fatal "emacs-version in $file is not $version: ${installed[emacs-version]-missing}"
    emacs_version=$version

    # Only the image that installed a version knows what it installed, and its tag may have moved.
    [[ $(docker image inspect --format '{{.Id}}' "$image_id" 2>/dev/null) == "$image_id" ]] \
        || fatal "recorded image $image_id is not available locally: $file"
}

run_installer() (
    local action=$1 operand=$2
    shift 2

    local directory=$install_prefix directory_seen=false directory_option=--into
    local project mount_source tag image_id security_options scratch cleanup_status=0
    local build_tree emacs_version source_directory='' installer="$root/emacsen-install.sh" script

    if [[ $action == uninstall ]]; then directory_option=--from; fi
    while (( $# )); do
        case $1 in
            "$directory_option")
                [[ $directory_seen == false ]] \
                    || fatal "$directory_option may be specified only once"
                [[ $# -ge 2 && -n $2 && $2 != --* ]] \
                    || fatal "$directory_option requires a directory"

                directory=$2
                directory_seen=true
                shift 2
                ;;
            *) fatal "expected $directory_option DIR, got: $1" ;;
        esac
    done

    script=$(<"$installer") || fatal "cannot read install script: $installer"
    require_commands docker

    security_options=$(docker info --format '{{json .SecurityOptions}}') \
        || fatal "cannot access Docker; check the daemon and your Docker permissions"
    check_rootful "$security_options"

    if [[ $action == install ]]; then
        tag="emacsen:$operand"
        image_id=$(docker image inspect --format '{{.Id}}' "$tag" 2>/dev/null) \
            || fatal "local image $tag is missing; build it with: $root/emacsen build $operand"
        [[ $image_id =~ ^sha256:[0-9a-f]{64}$ ]] \
            || fatal "invalid image identity returned for $tag"

        scratch=$(mktemp -d "${TMPDIR:-/tmp}/emacsen-install-XXXXXXXX")
        trap '
            cleanup_status=$?
            rm -rf -- "$scratch"
            exit "$cleanup_status"
        ' EXIT
        image_file "$image_id" /usr/share/emacsen/build-info "$scratch/build-info"
        check_installable "$scratch/build-info" "$operand"
        mkdir -p -- "$directory" || fatal "cannot create install directory: $directory"
    else
        check_uninstallable "$directory/$state_directory/installed/$operand" "$operand"
    fi

    project=$(CDPATH='' cd -P -- "$directory" 2>/dev/null && printf '%s/.' "$PWD") \
        || fatal "not an accessible directory: $directory"
    project=${project%/.}
    mount_source=${project//\"/\"\"}/.

    printf 'emacsen: %s %s (%s) %s %s\n' \
        "${action}ing" "$tag" "$image_id" "${directory_option#--}" "$project" >&2
    # An argument, not stdin: a child that reads stdin would swallow the rest of a piped script.
    docker run --rm --pull=never --network=none \
        --cap-drop=ALL --cap-add=CHOWN --cap-add=DAC_OVERRIDE --cap-add=FOWNER --cap-add=FSETID \
        --security-opt=no-new-privileges --user 0:0 \
        --mount "type=bind,\"source=$mount_source\",target=$install_prefix" \
        --env "EMACSEN_IMAGE_ID=$image_id" --env "EMACSEN_IMAGE_TAG=$tag" \
        --env "EMACSEN_EMACS_VERSION=$emacs_version" \
        --env "EMACSEN_STATE_DIRECTORY=$install_prefix/$state_directory" \
        --env "EMACSEN_SOURCE_DIRECTORY=$source_directory" \
        --workdir "$build_tree" --entrypoint bash "$image_id" \
        -c "$script" emacsen-install.sh "$action" >&2
    printf 'emacsen: %s %s (%s) %s %s\n' \
        "${action}ed" "$tag" "$image_id" "${directory_option#--}" "$project" >&2
)

run_image() {
    local action=$1 name=$2
    shift 2

    local directory=. directory_seen=false
    local project mount_source image_id uid gid
    local tag="emacsen:$name"
    local terminal_options=() entrypoint_options=()

    while (( $# )); do
        case $1 in
            --directory)
                [[ $directory_seen == false ]] || fatal "--directory may be specified only once"
                [[ $# -ge 2 && $2 != -- ]] || fatal "--directory requires a directory"
                directory=$2
                directory_seen=true
                shift 2
                ;;
            --)
                shift
                break
                ;;
            *)
                fatal "expected --directory DIR or --, got: $1"
                ;;
        esac
    done

    if [[ $action == exec ]]; then
        [[ $# -ge 1 && -n $1 ]] || fatal "exec requires COMMAND after --"
        entrypoint_options=(--entrypoint "$1")
        shift
    fi

    # The suffix preserves directory names ending in newlines through substitution.
    project=$(CDPATH='' cd -P -- "$directory" 2>/dev/null && printf '%s/.' "$PWD") \
        || fatal "not an accessible directory: $directory"
    project=${project%/.}

    require_commands docker
    if ! image_id=$(docker image inspect --format '{{.Id}}' "$tag" 2>/dev/null); then
        docker info >/dev/null 2>&1 \
            || fatal "cannot access Docker; check the daemon and your Docker permissions"
        fatal "local image $tag is missing; build it with: $root/emacsen build $name"
    fi
    [[ $image_id =~ ^sha256:[0-9a-f]{64}$ ]] || fatal "invalid image identity returned for $tag"

    uid=$(id -u)
    gid=$(id -g)
    if [[ $uid == 0 ]]; then
        uid=65534               # Use the "nobody" user inside the container for root on the host.
        gid=65534               # "nogroup"
    fi

    if [[ -t 0 && -t 1 ]]; then
        terminal_options=(--tty --env "TERM=${TERM:-xterm}")
    fi

    # Quote Docker's CSV field; /. also protects trailing path whitespace.
    mount_source=${project//\"/\"\"}/.
    printf 'emacsen: image %s (%s)\nemacsen: mounting %s at /work (read-only)\n' \
        "$tag" "$image_id" "$project" >&2
    # Docker mounts tmpfs noexec by default; native compilation loads the shared objects it
    # writes to TMPDIR and to the eln cache under HOME.
    exec docker run --rm --pull=never --interactive \
        "${terminal_options[@]}" \
        --network=none --read-only --cap-drop=ALL --security-opt=no-new-privileges \
        --user "$uid:$gid" --workdir /work \
        --env HOME=/home/runtime --env TMPDIR=/tmp --env LANG=C.UTF-8 \
        --tmpfs /tmp:rw,exec,nosuid,nodev,mode=1777 \
        --tmpfs "/home/runtime:rw,exec,nosuid,nodev,mode=700,uid=$uid,gid=$gid" \
        --mount "type=bind,\"source=$mount_source\",target=/work,readonly,bind-propagation=rprivate,bind-recursive=readonly" \
        "${entrypoint_options[@]}" \
        "$image_id" "$@"
}

# First pass: validate the command and its arguments.
case ${1-} in
    --help|-h)
        [[ $# -eq 1 ]] || fatal "--help takes no arguments"
        usage
        exit 0
        ;;
    build)
        [[ $# -ge 2 ]] || fatal "usage: emacsen build NAME [--variant x|server]"
        ;;
    update)
        [[ $# -eq 2 ]] || fatal "usage: emacsen update NAME"
        ;;
    install)
        [[ $# -ge 2 ]] || fatal "usage: emacsen install NAME [--into DIR]"
        ;;
    uninstall)
        [[ $# -ge 2 ]] || fatal "usage: emacsen uninstall VERSION [--from DIR]"
        ;;
    run)
        [[ $# -ge 2 ]] || fatal "usage: emacsen run NAME [--directory DIR] [-- EMACS-ARGS...]"
        ;;
    exec)
        [[ $# -ge 2 ]] || fatal "usage: emacsen exec NAME [--directory DIR] -- COMMAND [ARGS...]"
        ;;
    '') fatal "a command is required; see emacsen --help" ;;
    *) fatal "unknown command: $1; see emacsen --help" ;;
esac

root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
action=$1
operand=$2
if [[ $action == uninstall ]]; then
    [[ $operand =~ ^$version_pattern$ ]] || fatal "invalid Emacs version: $operand"
else
    [[ $operand =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && -f $root/recipes/$operand/recipe ]] \
        || fatal "no recipe named $operand"
fi

# Second pass: run the command.
shift 2
case $action in
    build) build_image "$operand" "$@" ;;
    update) update_source "$operand" ;;
    install|uninstall) run_installer "$action" "$operand" "$@" ;;
    run|exec) run_image "$action" "$operand" "$@" ;;
esac
